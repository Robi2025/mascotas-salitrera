NODE_ENV=development
PORT=3000
DB_PATH=./data/mascotas.db
# Producción gratuita: pega aquí la cadena de conexión de Neon.
# DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require
ALLOWED_ORIGINS=http://localhost:5500
SESSION_DAYS=30
# Genera un valor largo y aleatorio. Se usa una sola vez para crear el admin.
BOOTSTRAP_SECRET=cambiar-por-un-secreto-aleatorio-de-32-caracteres
