# ====== CONFIGURACION DEL BACKEND ======
#
# Copia este archivo a .env y ajusta los valores segun sea necesario.

# Puerto del servidor Express
PORT=3000

# Ruta de la base de datos SQLite
DB_PATH=./data/mascotas.db

# Origenes extra permitidos por CORS (separados por coma)
# Ejemplo:
# ALLOWED_ORIGINS=https://app.tu-dominio.com,https://admin.tu-dominio.com
ALLOWED_ORIGINS=

# ====== NOTAS ======
# - En produccion usa HTTPS.
# - No uses localhost como URL de API en la app Android.
